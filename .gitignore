# 工具与本地状态，不入库
.codebuddy/
node_modules/
*.log
.DS_Store
Thumbs.db

# 取数/验收脚本的临时截图目录（默认写到系统临时目录，若改到仓库内则忽略）
shots/
# 取数可续跑缓存（中间产物，不入库）
data/_soil_samples.json
# 按需生成的"地块 × 日"长表（约 15 MB，随时可由 npm run export:daily 重算）
tables/fact_parcel_daily.csv

# LibreOffice/OpenOffice 打开 CSV 时会写这种锁文件（文件被占用 ⇒ 导出会 EBUSY）。
# 它们是“某人正开着这个文件”的信号，**不是产物**，绝不能提交。
.~lock.*#

# 交付包（`npm run pack` 的产物，随时可重打）
dist/
